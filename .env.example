# Telegram Bot Token (Get from @BotFather on Telegram)
# This is FREE - just create a bot at https://t.me/botfather
TELEGRAM_BOT_TOKEN=

# Discord Bot Token (Optional - for Discord monitoring)
# Get from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Claude API Key (Optional - enables AI classification)
# Get free tier at: https://console.anthropic.com/
CLAUDE_API_KEY=

# JWT Secret (for user authentication)
# IMPORTANT: Change this to a random string in production!
JWT_SECRET=change-this-to-a-random-secret-in-production

# Email Configuration (Optional - for email notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_PATH=./data/opportunities.db

# Scraping Configuration
SCRAPE_INTERVAL_MINUTES=30
